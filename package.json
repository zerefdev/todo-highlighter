{
  "name": "todo-highlighter",
  "displayName": "Todo Highlighter",
  "description": "Highlights TODO keyword and lists all todos in the side bar.",
  "version": "2.0.0",
  "engines": {
    "vscode": "^1.125.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "todo",
    "highlight",
    "todo snippet",
    "todo highlight",
    "todo highlighter"
  ],
  "license": "MIT",
  "publisher": "zerefdev",
  "icon": "src/media/icon.png",
  "homepage": "https://github.com/zerefdev/todo-highlighter/blob/main/README.md",
  "repository": {
    "type": "git",
    "url": "https://github.com/zerefdev/todo-highlighter.git"
  },
  "bugs": {
    "url": "https://github.com/zerefdev/todo-highlighter/issues",
    "email": "contact@zeref.dev"
  },
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "browser": "./dist/extension.js",
  "capabilities": {
    "virtualWorkspaces": true,
    "untrustedWorkspaces": {
      "supported": true
    }
  },
  "contributes": {
    "configuration": {
      "title": "Todo Highlighter",
      "properties": {
        "todoHighlighter.textColor": {
          "type": "string",
          "default": "#f1f1f1",
          "description": "Controls the text color."
        },
        "todoHighlighter.stylingColor": {
          "type": "string",
          "default": "#e5aa25",
          "description": "Controls the styling color."
        },
        "todoHighlighter.stylingType": {
          "type": "string",
          "default": "background",
          "enum": [
            "background",
            "border",
            "textonly"
          ],
          "description": "Controls the highlight styling."
        },
        "todoHighlighter.stylingBorderRadius": {
          "type": "string",
          "default": "4px 16px",
          "description": "Controls the border radius."
        },
        "todoHighlighter.rulerLane": {
          "type": "string",
          "default": "Center",
          "enum": [
            "Left",
            "Right",
            "Center",
            "Full"
          ],
          "description": "The position in the overview ruler where the decoration should be rendered."
        },
        "todoHighlighter.enableRulerColor": {
          "type": "boolean",
          "default": true,
          "description": "Whether to enable decoration in the overview ruler."
        },
        "todoHighlighter.maxResults": {
          "type": "integer",
          "default": 512,
          "minimum": 1,
          "description": "Maximum number of files to scan for todos."
        },
        "todoHighlighter.include": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "**/*"
          ],
          "description": "Glob patterns of files/folders to scan. Binary files are skipped automatically."
        },
        "todoHighlighter.exclude": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "**/node_modules/**",
            "**/dist/**",
            "**/out/**",
            "**/build/**",
            "**/coverage/**",
            "**/vendor/**",
            "**/target/**",
            "**/venv/**",
            "**/__pycache__/**",
            "**/*.lock",
            "**/*-lock.json",
            "**/*.min.*",
            "**/.*/**"
          ],
          "description": "Glob patterns of files/folders to exclude."
        }
      }
    },
    "commands": [
      {
        "command": "todoHighlighter.refreshList",
        "category": "Todo Highlighter",
        "title": "Refresh Todo List",
        "icon": "$(refresh)"
      },
      {
        "command": "todoHighlighter.openFile",
        "category": "Todo Highlighter",
        "title": "Open File",
        "icon": "$(file)"
      }
    ],
    "snippets": [
      {
        "path": "src/todo.code-snippets"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "todoHighlighter",
          "title": "Todo Highlighter",
          "icon": "src/media/icon.svg"
        }
      ]
    },
    "views": {
      "todoHighlighter": [
        {
          "id": "todo-list",
          "name": "Todo List",
          "icon": "src/media/icon.svg"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "todoHighlighter.refreshList",
          "when": "view == todo-list",
          "group": "navigation"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "todo-list",
        "contents": "You have no todos yet."
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "npm run check-types && npm run lint && node esbuild.js",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "npm run check-types && npm run lint && node esbuild.js --production",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "format": "prettier --write .",
    "format-check": "prettier --check ."
  },
  "devDependencies": {
    "@types/node": "24.x",
    "@types/vscode": "^1.125.0",
    "esbuild": "^0.28.1",
    "eslint": "^10.5.0",
    "prettier": "^3.6.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.1"
  }
}
